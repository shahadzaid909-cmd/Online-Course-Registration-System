<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="online_course_registration_system.ViewController.BrowseCoursesController"
            prefHeight="700.0" prefWidth="1000.0">

    <top>
        <VBox BorderPane.alignment="CENTER">
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #ADD8E6; -fx-padding: 15;">
                <Label text="Browse and Register for Courses" textFill="#212121">
                    <font>
                        <Font name="System Bold" size="22.0"/>
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Back to Dashboard" onAction="#handleBackToDashboard"
                        style="-fx-background-color: #D3D3D3; -fx-text-fill: #212121; -fx-background-radius: 5;">
                    <font>
                        <Font name="System Bold" size="12.0"/>
                    </font>
                </Button>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="15" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>


            <Label fx:id="messageLabel" textFill="#4CAF50" wrapText="true" minHeight="30" alignment="CENTER">
                <font>
                    <Font name="System Bold" size="16.0"/>
                </font>
            </Label>

            <TableView fx:id="coursesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="courseCodeColumn" text="Course Code" prefWidth="150"/>
                    <TableColumn fx:id="courseNameColumn" text="Course Name" prefWidth="400"/>
                </columns>
            </TableView>

            <HBox spacing="15" alignment="CENTER">
                <Button text="Register" onAction="#handleRegister" prefWidth="150" prefHeight="35"
                        style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5;">
                    <font>
                        <Font name="System Bold" size="13.0"/>
                    </font>
                </Button>
            </HBox>
        </VBox>
    </center>

</BorderPane>
