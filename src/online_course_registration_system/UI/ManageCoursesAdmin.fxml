<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/17"
      fx:controller="online_course_registration_system.ViewController.ManageCoursesAdminController"
      spacing="20"
      style="-fx-background-color: #f5f5f5;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #ADD8E6; -fx-padding: 15;">
        <Label text="Manage Courses" textFill="#212121">
            <font>
                <Font name="System Bold" size="24"/>
            </font>
        </Label>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Back to Dashboard" onAction="#handleBackToDashboard"
                style="-fx-background-color: #D3D3D3; -fx-text-fill: #212121; -fx-background-radius: 5;">
            <font>
                <Font size="12"/>
            </font>
        </Button>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Add Course" onAction="#handleAddCourse"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-background-radius: 5;">
            <font>
                <Font size="12"/>
            </font>
        </Button>
    </HBox>

    <TableView fx:id="coursesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="courseIdColumn" text="Course Code" prefWidth="200"/>
            <TableColumn fx:id="courseNameColumn" text="Course Name" prefWidth="350"/>
            <TableColumn fx:id="professorColumn" text="Professor" prefWidth="300"/>
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Edit Course" onAction="#handleEditCourse"
                style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-background-radius: 5;" prefWidth="120">
            <font>
                <Font size="12"/>
            </font>
        </Button>
        <Button text="Delete Course" onAction="#handleDeleteCourse"
                style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-background-radius: 5;" prefWidth="120">
            <font>
                <Font size="12"/>
            </font>
        </Button>
    </HBox>

</VBox>
