<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="online_course_registration_system.ViewController.RoleSelectionController"
            prefHeight="500.0" prefWidth="600.0"
            style="-fx-background-color: #f5f5f5;">

    <top>
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #ADD8E6; -fx-padding: 40;">
            <Label text="Online Course Registration System" textFill="#212121">
                <font>
                    <Font name="System Bold" size="28.0"/>
                </font>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="25" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="60" right="80" bottom="60" left="80"/>
            </padding>

            <Label text="I am a:" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Button text="Student" onAction="#handleStudentRole" prefWidth="300" prefHeight="60"
                    style="-fx-background-color: #64B5F6; -fx-text-fill: #212121; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 10;">
            </Button>

            <Button text="Professor" onAction="#handleProfessorRole" prefWidth="300" prefHeight="60"
                    style="-fx-background-color: #64B5F6; -fx-text-fill: #212121; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 10;">
            </Button>

            <Button text="Administrator" onAction="#handleAdminRole" prefWidth="300" prefHeight="60"
                    style="-fx-background-color: #64B5F6; -fx-text-fill: #212121; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 10;">
            </Button>
        </VBox>
    </center>


</BorderPane>
