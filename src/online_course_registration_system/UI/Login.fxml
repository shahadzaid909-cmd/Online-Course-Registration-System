<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="online_course_registration_system.ViewController.LoginController"
            prefHeight="500.0" prefWidth="600.0" styleClass="root">

    <top>
        <VBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="50" bottom="20"/>
            </padding>
            <Label text="Online Course Registration System" styleClass="title">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>
            <Label text="Login to Your Account" styleClass="subtitle">
                <font>
                    <Font size="16.0"/>
                </font>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="100" right="100"/>
            </padding>

            <GridPane hgap="10" vgap="15" alignment="CENTER">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" prefWidth="100"/>
                    <ColumnConstraints minWidth="250" prefWidth="250"/>
                </columnConstraints>

                <Label fx:id="usernameLabel" text="Student ID:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Label>
                <TextField fx:id="usernameField" promptText="Enter Student ID"
                          GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </TextField>

                <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Label>
                <PasswordField fx:id="passwordField" promptText="Enter password"
                              GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </PasswordField>
            </GridPane>

            <Label fx:id="errorLabel" textFill="RED" wrapText="true">
                <font>
                    <Font size="12.0"/>
                </font>
            </Label>

            <HBox alignment="CENTER" spacing="20">
                <Button fx:id="loginButton" text="Login" onAction="#handleLogin"
                        prefWidth="150" prefHeight="40"
                        style="-fx-background-color: #ADD8E6; -fx-text-fill: #212121; -fx-font-weight: bold; -fx-background-radius: 5;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Button>
                <Button text="Back" onAction="#handleBack"
                        prefWidth="150" prefHeight="40"
                        style="-fx-background-color: #D3D3D3; -fx-text-fill: #212121; -fx-background-radius: 5;">
                    <font>
                        <Font size="14.0"/>
                    </font>
                </Button>
            </HBox>
        </VBox>
    </center>

</BorderPane>
